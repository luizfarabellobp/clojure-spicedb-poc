    {
      "name": "4. Alterar relações em runtime (muda o estado do banco)",
      "item": [
        {
          "name": "conceder direct_viewer de avatar_3 pra alice",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('written é true', function () {",
                  "  pm.expect(pm.response.json().written).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{alice_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resource-type\": \"movie\",\n  \"resource-id\": \"avatar_3\",\n  \"relation\": \"direct_viewer\",\n  \"subject-type\": \"user\",\n  \"subject-id\": \"alice\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/relationships",
              "host": ["{{base_url}}"],
              "path": ["relationships"]
            }
          },
          "response": []
        },
        {
          "name": "confirma: agora alice vê avatar_3",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
