                  "pm.test('allowed agora é true', function () {",
                  "  pm.expect(pm.response.json().allowed).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{alice_token}}" }],
            "url": {
              "raw": "{{base_url}}/movies/avatar_3/access",
